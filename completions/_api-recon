#compdef api-recon
# api-recon zsh completion — generated by `api-recon completion zsh`.
# Install: api-recon completion zsh > "${fpath[1]}/_api-recon"
_api_recon() {
  local -a commands flags
  commands=(
    'baseline:scan and save the report as the stored baseline for `--diff latest`, so CI need not manage a path'
    'verify:check reports against a checksums.json integrity manifest written by `--checksum`'
    'completion:print a shell completion script for bash, zsh, fish — install it once and the flags stop being something to remember'
  )
  flags=(
    '--version:output the version number'
    '--depth:same-domain crawl depth (0 = seed page only)'
    '--max-pages:hard cap on pages visited'
    '--open:open the dashboard in your browser when the scan finishes'
    '--share:write a share-safe one-page summary (share.md) instead of the full reports — no bodies, headers, or samples'
    '--print:print a report to stdout as well as writing files (md, json, openapi, html, share; default md). Human output moves to stderr, so it pipes cleanly'
    '--preset:bundle the flags for a common case — quick (one page, no crawl, skips the PDF render), deep (crawl further and include cross-origin traffic), ci (bounded, quiet, and machine-readable for a pipeline). A flag or an environment variable still wins'
    '--config:path to a project config file (default  the nearest api-recon.config.json / .api-reconrc.json / .api-reconrc up from the working directory)'
    '--no-config:ignore any project config file, even one found on the way up'
    '--out:output directory for reports'
    '--formats:comma-separated report formats (json,md,html,pdf,openapi,dashboard,share)'
    '--browser:Playwright engine to drive (chromium, firefox, webkit)'
    '--auth:path to a Playwright storageState.json for an authenticated session'
    '--login:path to a login-flow config (YAML/JSON) with ${ENV_VAR} substitution'
    '--record:interactive recording mode  drive the browser yourself, type "done" to finish'
    '--actions:path to scripted interaction steps (YAML/JSON)'
    '--rate:minimum delay between requests to the same origin'
    '--timeout:per-navigation timeout in milliseconds, with one retry on failure'
    '--resume:continue from <out>/checkpoint.json left by a crashed or cancelled run'
    '--respect-robots:respect robots.txt (default)'
    '--no-respect-robots:ignore robots.txt (requires --force to acknowledge ownership)'
    '--diff:compare this scan against a previous report.json — or the stored baseline with `--diff latest`'
    '--baseline:override where the stored baseline lives (used by the `baseline` subcommand and `--diff latest`)'
    '--fail-on-diff:with --diff, exit 3 when any endpoint changed (for CI gating)'
    '--include-third-party:capture cross-origin XHR/fetch calls as well'
    '--include-host:comma-separated hosts to treat as in scope beyond the seed, for a multi-host app'
    '--exclude-path:comma-separated URL paths to skip, as a prefix (/admin) or a glob (*.pdf)'
    '--redact:redact sensitive headers such as Authorization and Cookie (default)'
    '--no-redact:disable header redaction (not recommended)'
    '--strict-redaction:refuse to write the reports if a redacted value still appears in them'
    '--force:bypass robots.txt restrictions (only for systems you are allowed to test)'
    '--allow-local:allow scanning localhost and private network ranges'
    '--telemetry:write anonymized categorization signals to telemetry.json (off by default; no host, path, or body data)'
    '--telemetry-preview:print the anonymized telemetry payload to stdout instead of writing telemetry.json'
    '--max-body-mb:maximum response body / WebSocket frame size to keep, in MB'
    '--checksum:write a checksums.json integrity manifest over the reports (sha256 or sha512; default sha256)'
    '--sign-key:sign the checksums.json manifest with the HMAC key in this file'
    '--quiet:suppress progress output (errors only)'
    '--verbose:verbose progress output'
    '--json-progress:emit progress as JSON lines on stdout (one object per event) instead of a live table'
    '--debug:on failure, write a diagnostic bundle (logs, browser trace, and the partial report) for a bug report'
    '--help:show help for a command'
  )

  if [[ "${words[2]}" == "completion" ]]; then
    _values 'shell' bash zsh fish
    return
  fi

  case "${words[CURRENT-1]}" in
    --browser) _values 'value' chromium firefox webkit; return ;;
    --preset) _values 'value' quick deep ci; return ;;
    --print) _values 'value' md json openapi html share; return ;;
    --formats) _values 'value' json md html pdf openapi dashboard share; return ;;
    --checksum) _values 'value' sha256 sha512; return ;;
    --auth|--login|--actions|--config|--diff|--baseline|--sign-key|--out) _files; return ;;
  esac

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  _describe 'option' flags
}
_api_recon "$@"
